<!DOCTYPE html>
<html>
  <head>
    <title>Clinic Booking</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 860px; margin: 0 auto; padding: 0 1rem 3rem; color: #222; }
      nav { display: flex; gap: 1.25rem; padding: 1rem 0; border-bottom: 1px solid #ddd; margin-bottom: 1.5rem; }
      nav a { color: #222; text-decoration: none; font-weight: 500; }
      nav .brand { margin-right: auto; font-weight: 700; }
      a { color: #1f6feb; }
      table { width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; }
      th, td { text-align: left; padding: .5rem; border-bottom: 1px solid #eee; vertical-align: top; }
      .header { display: flex; justify-content: space-between; align-items: center; }
      .button, button, input[type=submit] { background: #1f6feb; color: #fff; border: 0; padding: .5rem .9rem; border-radius: 4px; text-decoration: none; cursor: pointer; font-size: .95rem; }
      .button-link { background: none; color: #c0392b; padding: 0; }
      .notice { background: #e6f4ea; padding: .6rem .9rem; border-radius: 4px; }
      .errors { background: #fdecea; padding: .6rem .9rem; border-radius: 4px; }
      .errors ul { margin: .3rem 0 0; }
      .muted { color: #777; }
      .field { margin-bottom: 1rem; }
      .field label { display: block; margin-bottom: .25rem; font-weight: 500; }
      .field input, .field select, .field textarea { padding: .4rem; font-size: 1rem; width: 100%; max-width: 360px; box-sizing: border-box; }
    </style>
  </head>

  <body>
    <nav>
      <%= link_to "Clinic Booking", root_path, class: "brand" %>
      <%= link_to "Appointments", appointments_path %>
      <%= link_to "Practitioners", practitioners_path %>
      <%= link_to "Patients", patients_path %>
    </nav>

    <% if notice %>
      <p class="notice"><%= notice %></p>
    <% end %>

    <%= yield %>
  </body>
</html>
